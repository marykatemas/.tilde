{
  "$schema" : "schema.json",
  "animationsEnabled" : false,
  "appExceptions" : [
    {
      "bundleID" : "com.apple.finder",
      "hide" : "whenNoWindows",
      "ignore" : "never"
    }
  ],
  "displayMode" : "activeWindow",
  "fontScale" : "extraLarge",
  "gridMaxColumns" : 0,
