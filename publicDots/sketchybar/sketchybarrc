#!/usr/bin/env bash

set -euo pipefail

SB_DIR="$(dirname "$0")"
SB=/opt/homebrew/bin/sketchybar

pkill -f "$SB_DIR/media.py stream" 2>/dev/null || true

"$SB" --bar \
	topmost=window \
	height=39 \
	notch_width=300 \
	color=0x00000000 \
	drawing=off

"$SB" --default \
	icon.font="Symbols Nerd Font:Regular:13.5" \
	label.font="SF Pro:Medium:13.5" \
	blur_radius=10 \
	icon.padding_left=7 \
	icon.padding_right=7 \
	label.padding_right=7 \
	background.color=0x01ffffff \
	background.border_color=0x2e8e8e93 \
	background.border_width=1 \
	background.corner_radius=4 \
	background.height=24 \
	drawing=off

"$SB" --add item media q
"$SB" --add item agent e
"$SB" --set /media/ label.max_chars=35
"$SB" --set /agent/ drawing=on icon=󰚩 icon.color=0x598e8e93 label=i label.color=0x9effffff

nohup /usr/bin/python3 "$SB_DIR/media.py" stream >/dev/null 2>&1 &
